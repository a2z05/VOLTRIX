<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Quick Settings tile: "VOLTRIX 67W" -->
      <service
        android:name=".VoltrixTileService"
        android:label="VOLTRIX 67W"
        android:icon="@drawable/voltrix_bolt"
        android:exported="true"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
          <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
      </service>

      <!-- Notification actions: Apply 67W / Dismiss (explicit PendingIntents only) -->
      <receiver
        android:name=".ChargeActionReceiver"
        android:exported="false">
        <intent-filter>
          <action android:name="com.vnerxy.voltrix.TOGGLE_67W" />
          <action android:name="com.vnerxy.voltrix.DISMISS" />
        </intent-filter>
      </receiver>

      <!-- Card entry point for the root watcher (charger connect/disconnect).
           exported so uid-0 broadcasts reach it; posting a notification is the
           extent of what a sender can do — TOGGLE (root scripts) stays in the
           non-exported receiver above, reached only via this app's PendingIntents. -->
      <receiver
        android:name=".ShowCardReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="com.vnerxy.voltrix.SHOW_CARD" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
